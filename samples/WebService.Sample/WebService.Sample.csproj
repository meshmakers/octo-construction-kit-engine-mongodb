<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>173d8e91-b831-4e8a-a43f-672c57e6a4da</UserSecretsId>
        <Configurations>Debug;Release;DebugL</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
        <!-- Pin transitive Microsoft.OpenApi to 2.7.5: the version AspNetCore.OpenApi 10.0.11 pulls in
             falls in the vulnerable range of advisory GHSA-v5pm-xwqc-g5wc (>= 2.0.0-preview11, <= 2.7.4);
             2.7.5 is the first patched release. NuGetAudit fails the build otherwise (warnings as errors).
             The pin cannot move to 3.x: AspNetCore.OpenApi 10.0.11 requires Microsoft.OpenApi < 3.0.0. -->
        <PackageReference Include="Microsoft.OpenApi" Version="3.10.2" />
        <PackageReference Include="NLog.Web.AspNetCore" Version="6.2.0" />
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Runtime.Engine.MongoDb\Runtime.Engine.MongoDb.csproj" />
    </ItemGroup>

</Project>
